# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# ---------------------------------------------------------------------------

# 监听端口（宿主机与容器内一致）
GATEWAY_PORT=8317

# 宿主机绑定地址
#   127.0.0.1  仅本机可访问（默认，最安全）
#   0.0.0.0    局域网可访问 —— 此时务必设置下方 GATEWAY_API_KEY
GATEWAY_BIND=127.0.0.1

# 网关访问密钥（客户端 Bearer）。留空 = 不鉴权。
# 启用示例：GATEWAY_API_KEY=sk-workbuddy-local-please-change
GATEWAY_API_KEY=

# 上游出口代理（可选）：降低上游风控概率 / 服务器需经代理出网时使用。
# Docker Desktop 上指向宿主机代理用 host.docker.internal；
# Linux 原生 docker 指向宿主机用 172.17.0.1（docker0 网桥地址）。
# UPSTREAM_PROXY=http://172.17.0.1:7890
UPSTREAM_PROXY=

# 官方模型目录刷新间隔（分钟），0 = 关闭
MODELS_REFRESH=60

# 时区（国内站每日签到按 UTC+8 09:00 触发）
TZ=Asia/Shanghai

# 容器内运行身份（非 root 运行）。须与宿主机 ./data 目录属主一致，否则写凭据会失败。
# 容器启动时 entrypoint 会自动修正挂载点属主，通常无需修改；
# 若宿主机 ./data 属于某个特定用户，用 `ls -lan data/` 查 uid/gid 后对齐填入。
PUID=1000
PGID=1000

# 逃生通道：任意额外 CLI 参数，空格分隔后追加到命令末尾
# 例：GATEWAY_EXTRA_ARGS=-verbose
GATEWAY_EXTRA_ARGS=
